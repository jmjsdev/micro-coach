{
  "name": "micro-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Application de micro-coaching et suivi d'habitudes - Monorepo",
  "workspaces": [
    "client",
    "admin",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:admin\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:admin": "npm run build --workspace=admin",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "prisma:studio": "npm run prisma:studio --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
